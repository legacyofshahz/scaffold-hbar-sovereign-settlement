# TESTNET ONLY. Copy to .env locally. Never commit .env.
DEPLOYER_PRIVATE_KEY=0x...

# Defaults to the deployer if omitted. Use a distinct key in real applications.
AUTHORIZER_PRIVATE_KEY=0x...

# Optional destination. Defaults to deployer address for a self-contained testnet proof.
RECIPIENT_ADDRESS=0x...

# Supra Push Oracle on Hedera testnet as documented by Supra.
SUPRA_FEED_ADDRESS=0x6Cd59830AAD978446e6cc7f6cc173aF7656Fb917
SUPRA_PAIR_ID=75
MAX_ORACLE_AGE_SECONDS=7200
PRICE_BAND_BPS=1000
TEST_AMOUNT_HBAR=0.001

# Required to create/submit HCS evidence during prove:testnet.
# These must be a Hedera testnet account ID and its matching private key.
HEDERA_OPERATOR_ID=0.0.x
HEDERA_OPERATOR_PRIVATE_KEY=...

# Optional: reuse an existing HCS topic. If omitted, prove:testnet creates one.
HEDERA_EVIDENCE_TOPIC_ID=

HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
HEDERA_RPC_URL=https://testnet.hashio.io/api
